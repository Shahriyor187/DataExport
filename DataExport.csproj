<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>DataExport</PackageId>
    <Version>1.1.0</Version>
    <Authors>Shahriyor Murodilov</Authors>
    <Description>A small .NET library for exporting dictionary-based data to JSON, XML, CSV, and Excel (XLSX).</Description>
    <PackageTags>data-export;csv;json;xml;excel;xlsx;export</PackageTags>
    <PackageProjectUrl>https://github.com/Shahriyor187/DataExport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahriyor187/DataExport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
