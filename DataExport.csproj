<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>DataExport</PackageId>
    <Version>2.0.0</Version>
    <Authors>Shahriyor Murodilov</Authors>
    <Description>Export C# objects, dictionaries and DataTables to CSV, TSV, JSON, XML and XLSX. Forward-only CSV, TSV and XLSX streaming for async records and DbDataReader, configurable row selection and progress reporting.</Description>
    <PackageTags>data-export;csv;tsv;json;xml;excel;xlsx;streaming;database;dbdatareader;reporting</PackageTags>
    <PackageProjectUrl>https://github.com/Shahriyor187/DataExport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahriyor187/DataExport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="benchmarks/**/*.cs" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly include package documentation; None Update can miss these items. -->
    <None Remove="README.md;LICENSE" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
