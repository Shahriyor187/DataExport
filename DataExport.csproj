<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>DataExport</PackageId>
    <Version>1.2.0</Version>
    <Authors>Shahriyor Murodilov</Authors>
    <Description>A lightweight .NET library for exporting C# objects, dictionaries, and DataTables to JSON, XML, CSV, and Excel (XLSX), with configurable output and streaming support.</Description>
    <PackageTags>data-export;csv;json;xml;excel;xlsx;export</PackageTags>
    <PackageProjectUrl>https://github.com/Shahriyor187/DataExport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shahriyor187/DataExport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly include package documentation; None Update can miss these items. -->
    <None Remove="README.md;LICENSE" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
